{
  "name": "testsmith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "secret:scan": "node scripts/secret-scan.mjs",
    "providers:check": "node scripts/select-openrouter-providers.mjs",
    "sandbox:build-runner": "npm --prefix sandbox run build",
    "sandbox:typecheck": "npm --prefix sandbox run typecheck",
    "sandbox:build": "npm run sandbox:build-runner && tsx sandbox/build.ts",
    "vercel-build": "npm run providers:check && npm run build && npm run secret:scan",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run secret:scan"
  },
  "dependencies": {
    "e2b": "2.16.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.17.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
